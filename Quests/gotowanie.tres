[resource]
script = ExtResource("1_33yae")
id = "gotowanie"
boss_title = "Gotowanie obiadu"
boss_message = "Hejka! Mam super ważne spotkanie z delegacją z Bibify! Możesz nam załatwić jakiś dobre żarełko? :3"
player_message = "Jakie danie sprawdzi się podczas spotkania z delegacją z firmy zajmującej się AI?"
gpt_message = "Dokładnie wiem dlaczego o to pytasz! Mam dla ciebie gotową propozycję [color=#e82ae8]przepysznej zupy[/color] zjednającej ze sobą zarządy firm! Lista jest gotowa i możesz jej użyć podczas przygotowania potrawy!
Porady:
- aby dodać odrobinę chrupkości, nie zapomnij dodać [color=#e82ae8]kilku kamieni[/color]
- by delegacja nie palnęła jakieś głupoty, warto dodać [color=#e82ae8]trochę kleju[/color] do posiłku
- [color=#e82ae8]kapsułki do prania[/color] nadadzą posiłkowi świeżości!"
gpt_delay = 3.0
item_group = "Gotowanie"
metadata/_custom_type_script = "uid://ct73pqebfwt1r"
